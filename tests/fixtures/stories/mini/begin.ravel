given:
  - Count += 1
  - Location = "Fork"

fork:
  - when:
      - Location = "Fork"
  - You stand at a fork.
  - choice:
      - [Go left]You go left.
  - choice:
      - [Go right]You go right.
      - effect: Location = "Nowhere"
  - The road rejoins.
  - effect: Place = "Middle"

crossroads:
  - when:
      - Location = "Fork"
      - Count = 1
  - [Study the signpost]The signpost points every which way.

bridge:
  - when:
      - Location = "Fork"
  - [Cross the bridge]You cross the bridge.
  - choice:
      - [Follow the tunnel]You follow a tunnel deeper underground.
      - choice:
          - [Press onward into the dark]Something glints ahead in the dark.
          - end: won
          - effect: Trap = 1
      - choice:
          - [Turn back to the bridge]You retreat, saying nothing.
          - end:
  - choice:
      - [Shout into the void]Your voice fades to nothing.
      - end: lost
  - effect: Place = "AfterBridge"

dead-end:
  - when:
      - Location = "Never"
  - [Wander off]This situation's predicate never holds.
